# Database
DATABASE_URL=postgresql+asyncpg://ffl:ffl@localhost:5432/ffl

# ATF data source (defaults built-in, override if URL changes)
ATF_DATA_URL=https://www.atf.gov/firearms/docs/undefined/ffllisting_0txt/download

# Geocoding (Census Geocoder — no key needed)
GEOCODE_BATCH_SIZE=2500
GEOCODE_BENCHMARK=Public_AR_Current
GEOCODE_VINTAGE=Current_Current

# API settings
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]
